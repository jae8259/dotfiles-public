[core]
	precomposeunicode = true
	quotepath = false
  editor = 'nvim'
[alias]
	tree = log --graph --pretty=format:'%Cgreen%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold cyan)<%an>%Creset' --abbrev-commit --date=relative
  unstage = restore --staged
